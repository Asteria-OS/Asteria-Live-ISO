[Plymouth Theme]
Name=Asteria OS
Description=Asteria OS celestial boot animation
ModuleName=two-step

[two-step]
Font=DejaVu Sans 12
ImageDir=/usr/share/plymouth/themes/asteria
HorizontalAlignment=.5
VerticalAlignment=.70
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.43
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
BackgroundStartColor=0x050817
BackgroundEndColor=0x050817
ProgressBarBackgroundColor=0x263456
ProgressBarForegroundColor=0x79d9ff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false
